# Copy to .env (in the project folder) only if you need to change these. Everything else is set in the app.

# Port the app listens on (http://127.0.0.1:8765 by default)
# MR_PORT=8765

# Where the database, caches, backups and logs are kept
# MR_DATA_DIR=C:\Users\you\MovieRoulette\data

# Address used when "Allow devices on my network" is on (Settings > Network)
# MR_LAN_BIND=0.0.0.0

# Explicit FFmpeg locations, if they are not on PATH or in tools\ffmpeg\bin
# MR_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# MR_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# TMDB key from the environment (normally entered in Settings > TMDB instead). Never commit a real key.
# MR_TMDB_API_KEY=

# DEBUG for more detail in data/logs/movie_roulette.jsonl
# MR_LOG_LEVEL=INFO
